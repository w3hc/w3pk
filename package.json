{
  "name": "w3pk",
  "version": "0.12.0",
  "description": "WebAuthn SDK for passwordless authentication, encrypted wallets, ERC-5564 stealth addresses, and zero-knowledge proofs",
  "author": "Julien Béranger",
  "license": "GPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/w3hc/w3pk.git"
  },
  "bugs": {
    "url": "https://github.com/w3hc/w3pk/issues"
  },
  "homepage": "https://github.com/w3hc/w3pk#readme",
  "keywords": [
    "webauthn",
    "passkey",
    "authentication",
    "passwordless",
    "fido2",
    "biometric",
    "ethereum",
    "web3",
    "encryption",
    "zero-knowledge",
    "zk-proofs",
    "zk-snarks",
    "privacy",
    "stealth-address",
    "erc-5564",
    "erc-6538",
    "unlinkable",
    "anonymous-transactions",
    "privacy-preserving",
    "ecdh",
    "secp256k1",
    "view-tags",
    "circom",
    "groth16",
    "merkle-tree",
    "commitment-scheme"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./zk": {
      "types": "./dist/zk/index.d.ts",
      "import": "./dist/zk/index.mjs",
      "require": "./dist/zk/index.js"
    },
    "./zk/utils": {
      "types": "./dist/zk/utils.d.ts",
      "import": "./dist/zk/utils.mjs",
      "require": "./dist/zk/utils.js"
    },
    "./chainlist": {
      "types": "./dist/chainlist/index.d.ts",
      "import": "./dist/chainlist/index.mjs",
      "require": "./dist/chainlist/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "docs/*.md",
    "scripts/compute-build-hash.mjs"
  ],
  "scripts": {
    "build": "tsup",
    "build:zk": "pnpm run build && pnpm run compile:circuits",
    "compile:circuits": "node scripts/compile-circuits.js",
    "dev": "tsup --watch",
    "test": "node scripts/run-tests.mjs",
    "test:basic": "node scripts/run-tests.mjs test/basic.test.ts",
    "test:comprehensive": "node scripts/run-tests.mjs test/comprehensive.test.ts",
    "test:backup": "node scripts/run-tests.mjs test/backup.test.ts test/backup-file.test.ts",
    "test:social-recovery": "node scripts/run-tests.mjs test/social-recovery.test.ts",
    "test:education": "node scripts/run-tests.mjs test/recovery-education.test.ts",
    "test:username": "node scripts/run-tests.mjs test/username-encoding.test.ts test/username-validation.test.ts",
    "test:recovery": "node scripts/run-tests.mjs test/backup.test.ts test/backup-file.test.ts test/social-recovery.test.ts test/recovery-education.test.ts",
    "test:zk": "node scripts/run-tests.mjs test/zk/zk.test.ts test/zk/babyjub.test.ts test/zk/elgamal.test.ts test/zk/artifacts.test.ts test/zk/zk-prove.test.ts test/zk/zk-proxy.test.ts test/zk/poseidon.test.ts",
    "test:nft": "node scripts/run-tests.mjs test/nft-ownership.test.ts",
    "test:chainlist": "node scripts/run-tests.mjs test/chainlist.test.ts",
    "test:eip7702": "node scripts/run-tests.mjs test/eip7702.test.ts",
    "test:eip7951": "node scripts/run-tests.mjs test/eip7951.test.ts",
    "test:erc5564": "node scripts/run-tests.mjs test/erc5564.test.ts",
    "test:sign-message": "node scripts/run-tests.mjs test/sign-message.test.ts",
    "test:siwe": "node scripts/run-tests.mjs test/siwe.test.ts",
    "test:auth": "node scripts/run-tests.mjs test/authenticate.test.ts",
    "prepublishOnly": "pnpm build",
    "build:hash": "node scripts/compute-build-hash.mjs",
    "check:deployments": "tsx scripts/check-deployments.ts",
    "build:standalone": "node scripts/build-standalone.mjs",
    "html": "lsof -ti:3000 | xargs kill -9 2>/dev/null || true && tsup && pnpm dlx serve . -l 3000 & sleep 5 && open http://localhost:3000/standalone/checker.html"
  },
  "packageManager": "pnpm@10.6.4",
  "devDependencies": {
    "@types/node": "^25.9.2",
    "@types/qrcode": "^1.5.5",
    "circomlib": "^2.0.5",
    "esbuild": "^0.27.2",
    "siwe": "3.0.0",
    "tsup": "^8.5.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "ethers": "^6.0.0"
  },
  "optionalDependencies": {
    "@ipld/car": "^5.4.6",
    "@semaphore-protocol/identity": "^4.14.5",
    "blockstore-core": "^7.0.1",
    "circomlibjs": "^0.1.7",
    "ipfs-unixfs-importer": "^17.0.1",
    "poseidon-lite": "^0.3.0",
    "qrcode": "^1.5.4",
    "snarkjs": "^0.7.6"
  },
  "dependencies": {
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "mlkem": "^2.7.0"
  },
  "pnpm": {
    "overrides": {
      "bn.js@>=5.0.0 <5.2.3": ">=5.2.3",
      "bn.js@<4.12.3": ">=4.12.3",
      "rollup@>=4.0.0 <4.59.0": ">=4.59.0",
      "minimatch@>=5.0.0 <11.0.1": ">=11.0.1",
      "jsonpath@<=1.2.1": ">=1.3.0",
      "brace-expansion@>=2.0.0 <2.0.3": ">=2.0.3",
      "brace-expansion@>=4.0.0 <5.0.12": ">=5.0.12",
      "picomatch@>=4.0.0 <4.0.4": ">=4.0.4",
      "underscore@<=1.13.7": ">=1.13.8",
      "ws@>=8.0.0 <8.20.1": ">=8.20.1"
    }
  }
}